# این فایل را به .env کپی کنید (cp .env.example .env) و مقادیر را تنظیم کنید.
# فایل .env هرگز نباید در گیت کامیت شود.

# برای توسعه‌ی محلی True؛ در production حتماً False
DJANGO_DEBUG=True

# کلید مخفی: با دستور زیر بسازید
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# در production (https): DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ir

# زرین‌پال
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=True

# پیامک: console | kavenegar
SMS_BACKEND=console
# KAVENEGAR_API_KEY=
# KAVENEGAR_OTP_TEMPLATE=verify

# دیتابیس: sqlite (پیش‌فرض) یا mysql
# DB_ENGINE=sqlite
# DB_NAME=supermarket
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
